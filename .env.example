# Secrets for homedash — copy to .env and fill in what you use (chmod 600). Widgets whose
# credentials are missing switch themselves off. Never commit .env.

# Plex: the X-Plex-Token from your server's Preferences.xml (PlexOnlineToken)
PLEX_TOKEN=

# Router stats (EE Smart Hub Pro via its USP/MQTT interface): the hub's admin password
EE_HUB_PASSWORD=

# Solar (SolaX Developer Portal application credentials)
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=

# Pi-hole v6 admin password (for ad-blocking stats on the network page)
PIHOLE_PASSWORD=

# Shared secret that lets tools like `dashnote` pin notes to the dashboard (any long random string)
HOMEDASH_TOKEN=
